[Unit]
Description=Loopback Jev classifier with optional OCG shadow comparison
After=network.target

[Service]
Type=simple
User=jev-ocg-adapter
Group=jev-ocg-adapter
LoadCredential=zen-key:/etc/jev-ocg-adapter/zen-key
ExecStart=/usr/local/libexec/jev-ocg-adapter -listen 127.0.0.1:8765 -backend jev -jev-model jev-1.13-free -timeout 1200ms
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
